# ============================================================
# LVA Document Classifier - Weeks 8-10+
# Copy this file to .env. NEVER commit real credentials.
# ============================================================

# Application
PORT=3000
MAX_FILE_SIZE_BYTES=2097152
ENABLE_INTERNAL_ROUTES=false

# Storage: azure or local
STORAGE_MODE=azure
LOCAL_UPLOAD_DIR=storage/uploads
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=lva-documents

# Zilliz Cloud / Milvus
MILVUS_ADDRESS=
MILVUS_TOKEN=
MILVUS_COLLECTION=GS_Schedules_All_Localities
MILVUS_VECTOR_DIM=384
MILVUS_INDEX_TYPE=AUTOINDEX
MILVUS_METRIC_TYPE=COSINE
MILVUS_ALL_LOCALITY_COLLECTION=GS_Schedules_All_Localities

# Production embedding model used by the Milvus collection
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DTYPE=q8
EMBEDDING_BATCH_SIZE=16
TRANSFORMERS_CACHE=.hf-cache

# Chunking and hybrid retrieval
CHUNK_SIZE_TOKENS=380
CHUNK_OVERLAP_TOKENS=64
MAX_DOCUMENT_CHUNKS=32
RETRIEVAL_PER_CHUNK=20
RETRIEVAL_CANDIDATE_POOL=24
RETRIEVAL_LEXICAL_POOL=20
RETRIEVAL_FINAL_K=3
RETRIEVAL_EVIDENCE_UNITS=18
RETRIEVAL_EVIDENCE_MIN_WORDS=6
RETRIEVAL_EVIDENCE_MAX_WORDS=90
RETRIEVAL_SEARCH_CONCURRENCY=4
CLASSIFIER_MAX_DOCUMENT_CHUNKS=8

# Optional local cross-encoder reranker. Keep disabled unless your benchmark proves an accuracy gain.
RERANKER_ENABLED=false
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_DTYPE=q8
RERANKER_CHUNKS_PER_CANDIDATE=3
RERANKER_MAX_PAIRS=72

# OCR
OCR_ENABLED=true
OCR_LANGUAGE=eng
PDF_OCR_PAGE_MIN_CHARS=40
PDF_OCR_MAX_PAGES=20
PDF_OCR_RENDER_SCALE=2

# Final classifier
CLASSIFIER_PROVIDER=gemini
CLASSIFIER_MODEL=gemini-3.5-flash-lite
CLASSIFIER_FALLBACK_MODELS=gemini-3.5-flash
GEMINI_API_KEY=
CLASSIFIER_THINKING_LEVEL=minimal

# Model-comparison settings
EMBEDDING_BENCHMARK_MODELS=Xenova/bge-small-en-v1.5,Xenova/e5-small-v2,Xenova/gte-small
CLASSIFIER_BENCHMARK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash
